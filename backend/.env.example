# Backend only. Never use VITE_ for a secret.
GEMINI_API_KEY=
GROQ_API_KEY=
HAWAHAWAI_AI_PROVIDER=gemini
HAWAHAWAI_GEMINI_MODEL=gemini-2.5-flash
HAWAHAWAI_GROQ_MODEL=llama-3.3-70b-versatile

# Local keys only. Lambda receives an ARN, never key values, via CDK.
# Live Groq availability depends on this account's model permissions.
# HAWAHAWAI_AI_SECRET_ARN is managed by HawaHawaiDev in AWS.
HAWAHAWAI_ENABLE_BEDROCK=false
AWS_PROFILE=hawahawai
AWS_REGION=us-east-1
