      },
      "post": {
        "operationId": "generateAdvisory",
        "x-implemented": false,
        "description": "Planned for Phase 3/4. Explains a persisted, current deterministic verdict.",
        "parameters": [
          {
            "name": "school_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvisoryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bilingual advisory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Advisory"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SchoolProfile": {
        "title": "SchoolProfile",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "school_id",
          "name",
          "city",
          "latitude",
          "longitude",
          "timezone",
          "languages",
          "is_demo"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0"
          },
          "school_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "city": {
            "enum": [
              "Delhi",
              "New Delhi",
              "Noida",
              "Greater Noida",
              "Ghaziabad",
              "Gurugram",
              "Faridabad"
            ]
          },
          "latitude": {
            "type": "number",
            "minimum": 27.8,
            "maximum": 29.5
          },
          "longitude": {
            "type": "number",
            "minimum": 76.5,
            "maximum": 78.0
          },
          "timezone": {
            "const": "Asia/Kolkata"
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "en",
                "hi"
              ]
            }
          },
          "is_demo": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Pilot bounding box is an MVP input guard, not an official Delhi-NCR administrative boundary. No student/medical data."
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "hawahawai-backend"
          },
          "environment": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "phase": {
            "const": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "environment",
          "version",
          "phase",
          "timestamp"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "SourceLocation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "station_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "latitude",
          "longitude",
          "station_id",
          "distance_km"
        ]
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "measurement",
              "model_forecast",
              "official_order"
            ]
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "fresh",
              "stale",
              "unknown"
            ]
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceLocation"
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "source_id",
          "name",
          "url",
          "kind",
          "observed_at",
          "retrieved_at",
          "valid_until",
          "freshness",
          "location",
          "limitations"
        ]
      },
      "Aqi": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number",
            "minimum": 0
          },
          "scale": {
            "type": "string",
            "enum": [
              "INDIA_AQI",
              "US_AQI",
              "EUROPEAN_AQI"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "value",
          "scale",
          "source_id",
          "observed_at"
        ]
      },
      "Pollutant": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "pm2_5",
              "pm10",
              "no2",
              "o3",
              "so2",
              "co"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "enum": [
              "ug/m3"
            ]
          },
          "averaging_period": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "averaging_period",
          "source_id",
          "observed_at"
        ]
      },
      "AirReading": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "stale",
              "unavailable"
            ]
          },
          "aqi": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Aqi"
            }
          },
          "pollutants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pollutant"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "school_id",
          "status",
          "aqi",
          "pollutants",
          "sources",
          "warnings"
        ]
      },
      "ForecastPoint": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "valid_at": {
            "type": "string",
            "format": "date-time"
          },
          "aqi": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Aqi"
            }
          },
          "pollutants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pollutant"
            }
          }
        },
        "required": [
          "valid_at",
          "aqi",
          "pollutants"
        ]
      },
      "Forecast": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "stale",
              "unavailable"
            ]
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForecastPoint"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "school_id",
          "status",
          "generated_at",
          "points",
          "sources",
          "warnings"
        ]
      },
      "GrapStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "VERIFY_STATUS"
            ]
          },
          "stage": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "order_url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "jurisdiction": {
            "type": "string"
          },
          "restrictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        },
        "required": [
          "status",
          "stage",
          "effective_from",
          "verified_at",
          "order_url",
          "jurisdiction",
          "restrictions",
          "sources"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "verified"
                }
              }
            },
            "then": {
              "properties": {
                "stage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "effective_from": {
                  "type": "string",
                  "format": "date-time"
                },
                "order_url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            "else": {
              "properties": {
                "stage": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "activity": {
            "type": "string",
            "enum": [
              "assembly",
              "sports",
              "physical_education",
              "other"
            ]
          },
          "instruction": {
            "type": "string"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "activity",
          "instruction",
          "rule_ids",
          "evidence_ids"
        ]
      },
      "Verdict": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "decided",
              "DATA_INSUFFICIENT",
              "VERIFY_STATUS"
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "GO_OUTDOORS",
                  "MODIFIED_OUTDOORS",
                  "INDOOR_ONLY"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "rule_version": {
            "type": "string"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Action"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "school_id",
          "status",
          "verdict",
          "generated_at",
          "valid_until",
          "rule_version",
          "rule_ids",
          "reasons",
          "actions",
          "evidence_ids",
          "sources",
          "warnings"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "decided"
                }
              }
            },
            "then": {
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "GO_OUTDOORS",
                    "MODIFIED_OUTDOORS",
                    "INDOOR_ONLY"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "verdict": {
                  "type": "null"
                }
              }
            }
          }
        ]
      },
      "AdvisoryRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "verdict_id": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "en",
                "hi"
              ]
            }
          }
        },
        "required": [
          "verdict_id",
          "languages"
        ]
      },
      "Advisory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school_id": {
            "type": "string"
          },
          "verdict_id": {
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "GO_OUTDOORS",
                  "MODIFIED_OUTDOORS",
                  "INDOOR_ONLY"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "en": {
            "type": "string"
          },
          "hi": {
            "type": "string"
          },
          "generator": {
            "type": "string",
            "enum": [
              "gemini",
              "groq",
              "bedrock",
              "rule_template"
