{
  "openapi": "3.1.0",
  "info": {
    "title": "HawaHawai API contracts",
    "version": "0.0.0",
    "description": "Phase 0: only /health is implemented. All /v1 routes are design contracts."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "x-implemented": true,
        "description": "Service liveness; does not assert air data or AI readiness.",
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schools/{school_id}": {
      "get": {
        "operationId": "getSchoolProfile",
        "x-implemented": false,
        "description": "Planned contract only; this route is not deployed in Phase 0.",
        "responses": {
          "200": {
            "description": "SchoolProfile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolProfile"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "school_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
            }
          }
        ]
      }
    },
