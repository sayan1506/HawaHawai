    "/v1/schools/{school_id}/advisory": {
      "get": {
        "operationId": "getAdvisory",
        "x-implemented": false,
        "description": "Planned contract only; this route is not deployed in Phase 0.",
        "responses": {
          "200": {
            "description": "Advisory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Advisory"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
